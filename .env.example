# 全部都是可选的：不建这个文件也能启动（docker compose up -d）。
# 要改哪一项，抄一份成 .env，把那一行前面的 # 去掉再改。.env 不要提交到仓库。

# ---------- 访问 ----------
# QS_PORT=8080                 # 网页端口
# QS_BIND=127.0.0.1            # 0.0.0.0 = 局域网里别的设备也能打开（先看 README 的"安全"）
# ALLOWED_ORIGINS=localhost:*,127.0.0.1:*   # 用别的地址打开时（局域网 IP、域名）要加上，例如 192.168.1.10:*
# SITE_DOMAIN=                 # 对外的域名（钱包登录的签名消息要校验它）

# ---------- 行情 ----------
# MARKET_SOURCE=binance        # binance = 币安的公开行情（不用密钥）；sim = 模拟行情（连不上币安的地方用它看界面）
# BINANCE_SPOT_WS_URL=wss://stream.binance.com:443   # 现货行情推送地址（不影响合约）；连不上时可以试 wss://data-stream.binance.vision:443
# HYPERLIQUID=1                # 0 = 不接 Hyperliquid 的链上数据
# LIQ_FEEDS=on                 # off = 不连 Bybit、OKX 的全量强平推送（爆仓流只用币安的）

# ---------- 发信邮箱：注册验证码、忘记密码、邮件通知 ----------
# 用你自己的邮箱。密码填邮箱设置里生成的"应用专用密码 / 授权码"，不是登录密码。
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465                # 465（TLS）或 587（STARTTLS）
# SMTP_USER=you@example.com
# SMTP_PASSWORD=
# MAIL_FROM=                   # 不填用 SMTP_USER
# MAIL_FROM_NAME=              # 不填用产品名
# AUTH_DEV=                    # 不填 = 自动：没配发信邮箱时验证码显示在页面上，配了就真的发邮件

# ---------- 通知 ----------
# TELEGRAM_BOT_TOKEN=          # 自己找 @BotFather 建一个 bot，见 docs/telegram.md

# ---------- 新闻标题（市场页"今日"） ----------
# NEWS_FEEDS=                  # 不填 = 默认几家加密媒体的公开 RSS；自己写：多个地址用逗号隔开；off = 不取
# X_BEARER_TOKEN=              # 可选：X 官方接口的 token（你自己的开发者账号，按量收费）。不填就不取 X
# X_ACCOUNTS=                  # 要看的 X 账号，逗号隔开，例如 binance,coinbase（每 15 分钟取一次）
# NEWS_NOTICES=on              # off = 不取 Bybit、OKX 的官方公告（上新、下架、维护）

# ---------- 经济日历和宏观（可选） ----------
# FRED_API_KEY=                # 圣路易斯联储的免费密钥（fred.stlouisfed.org 注册后在 My Account → API Keys 里建）。
#                              # 填了以后：CPI、非农、PPI、议息日程全自动更新；市场页"今日"多显示美元指数、美债、标普 500。
#                              # 不填：经济分析局的日程照样在线更新，劳工统计局用程序里内置的（快用完时页面上会提前两个月提醒）

# ---------- 每人的上限 ----------
# 不填就是默认值；模拟资金本身不限额度：
# QS_LIMIT_PAPER_ACCOUNTS=10          # 模拟账户
# QS_LIMIT_BACKTEST_DAYS=180          # 回测一次最多几天
# QS_LIMIT_BACKTEST_INSTRUMENTS=5     # 回测一次最多几个品种
# QS_LIMIT_BACKTEST_SIGNALS=20000     # 回测一次最多几条信号
# QS_LIMIT_STRATEGIES=20              # 策略
# QS_LIMIT_API_KEYS=10                # 和币安一样的接口密钥
# QS_LIMIT_PRICE_ALERTS=50            # 到价提醒
# QS_LIMIT_RULES=20                   # 条件提醒
# QS_LIMIT_SHOT_MB=5                  # 复盘截图单张（MB）
# QS_LIMIT_SHOTS_TOTAL_MB=500         # 复盘截图每人总共（MB）
# QS_LIMIT_SIGNUP_PER_IP_HOUR=10      # 同一网络一小时最多注册几个

# ---------- 加密和权限 ----------
# QS_MASTER_KEY=               # 不填 = 第一次启动自动生成，存在 qs-data 数据卷里。自己指定：openssl rand -base64 32
# QS_SIGNUP=closed             # 第一个账号以后别人能不能自己注册：closed（默认）= 不能；open = 能。注册进来的人和你权限一样，"系统"页里也能改
# POSTGRES_PASSWORD=qs_local_dev   # 第一次启动前改才有效（数据库建好以后改这里不会改数据库里的密码）

# ---------- 实盘 ----------
# QS_LIVE_MAIN=1               # 0 = 不允许接币安正式环境
# QS_LIVE_TESTNET=1            # 0 = 不显示币安模拟交易
# BINANCE_API_KEY=             # 可选、只读就够：读所有品种真实的保证金分档
# BINANCE_API_SECRET=

# ---------- 策略 ----------
# QSIG_KEYS=                   # 一般不用：在网页"账户 → 我的策略"里自助建就行
# DEMO_STRATEGY=0              # 1 = 跑一个随机信号的示例策略（只为了看接进来是什么样，不是策略）

# ---------- AI 复盘点评（可选；推荐登录后在"系统"页加厂商，那里选了哪家优先用哪家） ----------
# AI_FORMAT=                   # anthropic = 用 Claude 自己的接口，只填 AI_API_KEY 就行（默认 claude-opus-5-5）；不填 = OpenAI 兼容的接口（DeepSeek、通义千问、Kimi 等），三项都要填
# AI_API_KEY=
# AI_BASE_URL=
# AI_MODEL=
# AI_EFFORT=                   # 思考程度：none / low / medium / high / xhigh；不填 = 按模型自己的设置

# ---------- 其他 ----------
# BRAND_NAME=Temper            # 发信人名字、健康检查里显示的名字
# QS_WEBHOOK_PRIVATE=0         # 1 = 对外 Webhook 允许发到本机和内网（只在自己内网部署时开）
# QS_BACKEND_IMAGE=            # 有现成镜像时填，docker compose pull 就不用本机构建
# QS_WEB_IMAGE=
# QS_PULL_POLICY=build          # 默认每次 docker compose up 都按现在的代码构建（没改动时用缓存，半分钟左右）；用上面的现成镜像时改成 missing

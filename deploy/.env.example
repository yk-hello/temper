# 复制成 deploy/.env 再填（deploy/.env 不进仓库）。都不填也能启动：真实行情、模拟盘、回测都能用。

# 实盘：加密交易所密钥用的主密钥，32 字节随机数的 base64。不填就不能接交易所账户。
# 生成：openssl rand -base64 32    丢了不能解开已存的密钥，只能重新接入。
QS_MASTER_KEY=

# 行情：binance（真实行情，默认）或 sim（模拟行情，不连币安）
MARKET_SOURCE=binance

# 程序化策略（qsig/1）的密钥：key_id:secret:strategy_id，多个用分号隔开
QSIG_KEYS=

# 可选：币安只读密钥，读所有品种真实的保证金分档（不填时只有 BTC 是完整的）
BINANCE_API_KEY=
BINANCE_API_SECRET=

# 0 = 不允许接币安正式环境 / 币安模拟交易（原来的合约测试网）
QS_LIVE_MAIN=1
QS_LIVE_TESTNET=1

# 可选：AI 复盘点评。也可以不写这里，在管理后台"系统设置"里填（填了的优先，马上生效）
# AI_FORMAT=anthropic 用 Claude 自己的接口（AI_BASE_URL、AI_MODEL 可以不填，默认官方地址和 claude-opus-5-5）；
# 不写 = OpenAI 兼容接口（DeepSeek、通义千问、Kimi、智谱、OpenAI 等），三项都要填
AI_FORMAT=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# 可选：Telegram 通知
TELEGRAM_BOT_TOKEN=

# 1 = 后端内部跑一个随机信号的示例策略（demo-random），只用来测试接法和界面，界面上标着"示例"。默认关
DEMO_STRATEGY=0


# 对外 Webhook 默认不发到本机和内网（服务器在公网时防止被拿来打内网）。只在自己内网部署、确实要发到内网服务时设 1
QS_WEBHOOK_PRIVATE=0

# 第一个账号以后，别人还能不能自己注册。默认 closed：这台是你一个人用的，放在云上也没人能注册进来。
# 要给家人、朋友开账号，可以在"系统"页里打开注册，或者在那里直接添加账号。
QS_SIGNUP=closed
